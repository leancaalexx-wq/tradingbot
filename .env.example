# Runtime mode
LIVE_TRADING=false
DRY_RUN=true

# Strategy profile. These values match --optimized-profile.
MIN_ENTRY_PRICE=0.70
MAX_ENTRY_PRICE=0.90
MIN_EXPECTED_PROFIT_USDC=0.05
MIN_SECONDS_TO_CLOSE=5
MAX_SECONDS_TO_CLOSE=180

# Risk and polling
STAKE_USDC=100
POLL_SECONDS=5
POLYMARKET_SERIES_SLUG=btc-up-or-down-5m

# API endpoints
GAMMA_BASE_URL=https://gamma-api.polymarket.com
CLOB_BASE_URL=https://clob.polymarket.com
REQUEST_TIMEOUT_SECONDS=10

# Required only for live trading. Never commit real secrets.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_CHAIN_ID=137
